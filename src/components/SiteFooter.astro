---
import { site } from "../site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>{site.brand.name} · {site.brand.caption}</p>
    <div class="footer-links">
      <a href={`${base}/contributors/`}>贡献者</a><a href={site.links.repository}
        >源代码</a
      ><a href={site.links.license}>MIT 许可证</a><a href={site.links.discord}
        >加入社区</a
      ><a href={site.links.x}>在 X 上关注我们</a>
    </div>
  </div>
</footer>
