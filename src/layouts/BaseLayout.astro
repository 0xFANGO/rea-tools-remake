---
import { site, locales } from "../site";
import messages from "../messages.zh-CN.json";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Page body class, e.g. "home-page" on the homepage. */
  bodyClass?: string;
  /** Per-page module scripts, appended after the shared ones. */
  modules?: string[];
}

const { title, description, bodyClass, modules = [] } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (file: string) => `${base}/assets/${file}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialCard = new URL(`${base}/assets/social-card.svg`, Astro.site).href;
---

<!doctype html>
<html lang={site.locale} dir={site.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Canonical and sharing metadata point at this remake, never at the
        reference site, so the original never competes with a copy. */}
    <link rel="canonical" href={canonical} />
    {
      locales.map((locale) => (
        <link rel="alternate" hreflang={locale.code} href={locale.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href="https://rea.tools/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.socialCardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard} />
    <meta name="twitter:image:alt" content={site.socialCardAlt} />

    <meta name="theme-color" content="#ffffff" />
    {/* Blocking so the saved theme lands before the first paint. */}
    <script is:inline src={asset("theme.js")}></script>

    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="stylesheet" href={asset("styles.css")} />
    <script is:inline src={asset("main.js")} defer></script>
    {
      modules.map((module) => (
        <script is:inline type="module" src={asset(module)}></script>
      ))
    }
    <script
      id="website-messages"
      type="application/json"
      is:inline
      set:html={JSON.stringify(messages)}
    />
  </head>
  <body class={bodyClass} id="top">
    <a class="skip-link" href="#main">跳转到内容</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <p class="sr-only" id="copy-status" role="status" aria-live="polite"></p>
    <a class="back-to-top" href="#top" aria-label="回到顶部">
      <span aria-hidden="true">↑</span> 顶部
    </a>
  </body>
</html>
