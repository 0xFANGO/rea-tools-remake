---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, navigation } from "../site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="找不到这一页 — REA" description="这个地址在本复刻项目中不存在。">
  <main id="main">
    <section class="container hero">
      <p class="eyebrow">404</p>
      <h1>找不到这一页。</h1>
      <p class="lede">
        这个地址在本复刻项目中不存在。本项目只复刻了参考站的首页，
        其余路由会给出说明页。
      </p>
      <div class="actions">
        <a class="button" href={`${base}/`}>回到首页</a>
        <a class="text-link" href={site.reference.home} rel="noreferrer"
          >打开 {site.reference.name} 参考站 →</a
        >
      </div>
      <div class="home-reading-links">
        {
          navigation.map((item) => (
            <p>
              <a href={`${base}/${item.href}`}>{item.label} →</a>
            </p>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
